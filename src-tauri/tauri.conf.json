{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "rebra",
    "version": "0.1.0",
    "identifier": "com.cosm.rebra",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "rebra",
                "width": 1000,
                "height": 800,
                "minWidth": 640,
                "minHeight": 600
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data:",
                "font-src": "'self' data:",
                "connect-src": "'self' ipc: http://ipc.localhost",
                "media-src": "'self'"
            },
            "devCsp": {
                "default-src": "'self'",
                "script-src": "'self' 'unsafe-inline'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data:",
                "font-src": "'self' data:",
                "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
                "media-src": "'self'"
            },
            "dangerousDisableAssetCspModification": ["style-src"]
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
